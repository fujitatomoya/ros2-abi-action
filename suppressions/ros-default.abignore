# ros2-abi-action — default ROS 2 suppression spec
#
# Opinionated suppressions for ABI deltas that are commonly noisy in ROS 2
# shared libraries but are not meaningful public-ABI breaks. This file is merged
# with the consumer repository's own suppression file (e.g. .abignore) when both
# exist; see "Suppressions" in the README.
#
# Format: libabigail suppression specification.
#   man libabigail-suppr-spec
#   https://sourceware.org/libabigail/manual/libabigail-concepts.html#suppression-specifications
#
# Keep this list conservative: every entry here hides a potential break from
# every consuming repository, so only suppress patterns that are genuinely
# benign implementation/template churn.

# ---------------------------------------------------------------------------
# C++ standard library template instantiation churn.
# These types are not part of any ROS package's public ABI; changes to their
# internal layout come from the toolchain/libstdc++, not from the package.
#
# Suppressions only reach declarations that have debug info. libstdc++
# instantiations that survive in the symbol table without DWARF ("symbols not
# referenced by debug info" in the abidiff report) are dropped separately by
# passing unreferenced-symbols: 'false' to libabigail-action (action.yml).
#
# accessed_through limits the type suppressions below to std:: types reached
# through a pointer or a reference. A std:: type held BY VALUE in a public
# class is part of that class's layout: when a std::variant member gains an
# alternative the class grows, and libabigail would otherwise drop the whole
# class diff together with the suppressed member (a diff node whose changed
# children are all suppressed is suppressed itself, a size change does not
# keep it alive), i.e. report an ABI break as compatible.
# ---------------------------------------------------------------------------
[suppress_type]
  name_regexp = ^std::
  accessed_through = reference-or-pointer

[suppress_function]
  name_regexp = ^std::

[suppress_variable]
  name_regexp = ^std::

# ---------------------------------------------------------------------------
# Internal/private symbols. Names mangled into the ::detail / ::impl namespaces
# (or leading-underscore reserved names) are implementation details, not API.
# Same accessed_through reasoning as above: a detail:: type embedded by value
# in a public class still decides that class's layout.
#
# Types defined outside include/ are covered regardless of their name by the
# public-headers-regexp input (action.yml), which libabigail-action turns into
# a generated spec next to this one.
# ---------------------------------------------------------------------------
[suppress_type]
  name_regexp = (^|::)(detail|impl|internal)::
  accessed_through = reference-or-pointer

[suppress_function]
  name_regexp = (^|::)(detail|impl|internal)::

# ---------------------------------------------------------------------------
# Third-party symbols that occasionally leak into a package's DWARF
# (e.g. fmt, spdlog, tinyxml2). Their churn is owned upstream, not by ROS.
# Uncomment / extend per repository if these become noisy.
# ---------------------------------------------------------------------------
# [suppress_type]
#   name_regexp = ^(fmt|spdlog|tinyxml2)::
